# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Replace with MongoDB Atlas connection string in Production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_expense_tracker?retryWrites=true&w=majority

# JWT Authentication (Set a strong 32+ character secret key in Production)
JWT_SECRET=replace_with_a_secure_random_production_jwt_secret_key_32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Set to your deployed Frontend URL in Production)
CLIENT_URL=https://your-frontend-app.vercel.app

# SMTP Email Configuration (Optional - for budget alert & notification emails)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_production_smtp_username
SMTP_PASSWORD=your_production_smtp_password
